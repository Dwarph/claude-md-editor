{
  "name": "claude-md-editor",
  "version": "0.4.0",
  "private": true,
  "description": "Shared WYSIWYG markdown editor for you and a Claude agent: live suggestions, accept/reject, and code-review style comments.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev:web": "vite",
    "start": "node server/index.js",
    "test": "vitest run",
    "typecheck:mod": "tsc -p mod",
    "package:plugin": "npm run build && node scripts/package-plugin.mjs"
  },
  "dependencies": {
    "@milkdown/kit": "^7.22.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "lib0": "^0.2.119",
    "linkedom": "^0.18.13",
    "ws": "^8.22.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@milkdown/crepe": "^7.22.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "y-websocket": "^3.1.0"
  }
}
